<!DOCTYPE html>
<html>

<head>

<title>Prudhvi Restaurant</title>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet" href="css/style.css">

</head>

<body>

<!-- NAVBAR -->

<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">

<div class="container">

<a class="navbar-brand fw-bold" href="#">
Prudhvi Restaurant
</a>

<button class="navbar-toggler"
data-bs-toggle="collapse"
data-bs-target="#menu">

<span class="navbar-toggler-icon"></span>

</button>

<div class="collapse navbar-collapse" id="menu">

<ul class="navbar-nav ms-auto">

<li class="nav-item">
<a class="nav-link" href="#home">Home</a>
</li>

<li class="nav-item">
<a class="nav-link" href="#menu-section">Menu</a>
</li>

<li class="nav-item">
<a class="nav-link" href="#booking">Booking</a>
</li>

<li class="nav-item">
<a class="nav-link" href="#reviews">Reviews</a>
</li>

<li class="nav-item">
<a class="nav-link" href="#contact">Contact</a>
</li>

</ul>

</div>

</div>

</nav>

<!-- HERO SECTION -->

<section class="hero" id="home">

<div class="overlay">

<div class="hero-content">

<h1>Luxury Dining Experience</h1>

<p>
Taste Premium Food At Prudhvi Restaurant
</p>

<button class="btn btn-warning btn-lg">
Order Online
</button>

<button class="btn btn-light btn-lg">
Book Table
</button>

</div>

</div>

</section>

<!-- MENU SECTION -->

<section class="container py-5" id="menu-section">

<h1 class="text-center mb-5">
Popular Dishes
</h1>

<div class="row">

<div class="col-md-4">

<div class="card shadow menu-card">

<img src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd"
class="card-img-top">

<div class="card-body text-center">

<h3>Burger Combo</h3>

<h5>₹199</h5>

<button class="btn btn-dark">
Add To Cart
</button>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card shadow menu-card">

<img src="https://images.unsplash.com/photo-1600891964092-4316c288032e"
class="card-img-top">

<div class="card-body text-center">

<h3>Chicken Biryani</h3>

<h5>₹299</h5>

<button class="btn btn-dark">
Add To Cart
</button>

</div>

</div>

</div>

<div class="col-md-4">

<div class="card shadow menu-card">

<img src="https://images.unsplash.com/photo-1513104890138-7c749659a591"
class="card-img-top">

<div class="card-body text-center">

<h3>Pizza</h3>

<h5>₹249</h5>

<button class="btn btn-dark">
Add To Cart
</button>

</div>

</div>

</div>

</div>

</section>

<!-- BOOKING SECTION -->

<section class="bg-dark text-white py-5" id="booking">

<div class="container">

<h1 class="text-center mb-5">
Reserve Your Table
</h1>

<form>

<div class="row">

<div class="col-md-4">
<input type="text"
class="form-control"
placeholder="Enter Name">
</div>

<div class="col-md-4">
<input type="date"
class="form-control">
</div>

<div class="col-md-4">
<input type="time"
class="form-control">
</div>

</div>

<div class="text-center mt-4">

<button class="btn btn-warning btn-lg">
Book Now
</button>

</div>

</form>

</div>

</section>

<!-- REVIEWS -->

<section class="container py-5" id="reviews">

<h1 class="text-center mb-5">
Customer Reviews
</h1>

<div class="row">

<div class="col-md-4">

<div class="card shadow p-4">

<h3>★★★★★</h3>

<p>
Amazing taste and excellent service.
</p>

<h5>- Rahul</h5>

</div>

</div>

<div class="col-md-4">

<div class="card shadow p-4">

<h3>★★★★★</h3>

<p>
Very beautiful restaurant atmosphere.
</p>

<h5>- Sneha</h5>

</div>

</div>

<div class="col-md-4">

<div class="card shadow p-4">

<h3>★★★★★</h3>

<p>
Best online ordering experience.
</p>

<h5>- Arjun</h5>

</div>

</div>

</div>

</section>

<!-- CONTACT -->

<section class="bg-light py-5" id="contact">

<div class="container text-center">

<h1>Contact Us</h1>

<p>
Customer Helpline: +91 9876543210
</p>

<p>
Email: support@prudhvirestaurant.com
</p>

<a href="https://wa.me/919876543210"
class="btn btn-success btn-lg">
Order On WhatsApp
</a>

</div>

</section>

<!-- FOOTER -->

<footer class="text-center">

<h4>
Prudhvi Restaurant © 2026
</h4>

</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
